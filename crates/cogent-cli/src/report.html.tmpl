<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cogent Audit — __PROJECT__</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,500;0,9..40,700;0,9..40,800;1,9..40,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f8fafc;
  --surface: #ffffff;
  --surface-alt: #f1f5f9;
  --border: #e2e8f0;
  --border-light: #f1f5f9;
  --text: #0f172a;
  --text-secondary: #475569;
  --text-muted: #94a3b8;
  --text-faint: #cbd5e1;
  --accent: #6366f1;
  --accent-light: #818cf8;
  --green: #22c55e;
  --green-bg: #ecfdf5;
  --green-border: #a7f3d0;
  --red: #ef4444;
  --red-bg: #fef2f2;
  --red-border: #fecaca;
  --amber: #f59e0b;
  --amber-bg: #fffbeb;
  --blue: #3b82f6;
  --blue-bg: #eff6ff;
  --icon-fail: #ef4444;
  --icon-pass: #22c55e;
  --offender-loc: #6366f1;
  --offender-desc: #6b7280;
  --offender-border: #f3f4f6;
  --offender-bg: #f9fafb;
  --header-border: #f3f4f6;
  --section-border: #f3f4f6;
  --footer-border: #e2e8f0;
  --sidebar-bg: #0f172a;
  --sidebar-text: #94a3b8;
  --sidebar-active: #e2e8f0;
  --sidebar-hover: #1e293b;
  --shadow-sm: 0 1px 2px rgba(0,0,0,.04), 0 1px 3px rgba(0,0,0,.06);
  --shadow-md: 0 4px 6px -1px rgba(0,0,0,.06), 0 2px 4px -2px rgba(0,0,0,.06);
  --shadow-lg: 0 10px 15px -3px rgba(0,0,0,.08), 0 4px 6px -4px rgba(0,0,0,.06);
  --radius: 14px;
  --radius-sm: 8px;
  --radius-xs: 6px;
}

[data-theme="dark"] {
  --bg: #0c1222;
  --surface: #131b2e;
  --surface-alt: #1a2340;
  --border: #1e293b;
  --border-light: #1e293b;
  --text: #f1f5f9;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --text-faint: #475569;
  --green: #34d399;
  --green-bg: #064e3b;
  --green-border: #065f46;
  --red: #f87171;
  --red-bg: #450a0a;
  --red-border: #7f1d1d;
  --amber: #fbbf24;
  --amber-bg: #451a03;
  --blue: #60a5fa;
  --blue-bg: #172554;
  --icon-fail: #f87171;
  --icon-pass: #34d399;
  --offender-loc: #818cf8;
  --offender-desc: #94a3b8;
  --offender-border: #1e293b;
  --offender-bg: #1a2340;
  --header-border: #1e293b;
  --section-border: #1e293b;
  --footer-border: #1e293b;
  --sidebar-bg: #070d1a;
  --sidebar-hover: #131b2e;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.3);
  --shadow-md: 0 4px 6px rgba(0,0,0,.3);
  --shadow-lg: 0 10px 15px rgba(0,0,0,.4);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

code, .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }

a { color: var(--accent); text-decoration: none; transition: color .15s; }
a:hover { color: var(--accent-light); }

.layout { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }

/* ── Sidebar ── */
.sidebar {
  background: var(--sidebar-bg);
  color: var(--sidebar-text);
  padding: 32px 0;
  position: sticky; top: 0; height: 100vh; overflow-y: auto;
  border-right: 1px solid rgba(255,255,255,.06);
}
.sidebar .brand { padding: 0 24px 28px; border-bottom: 1px solid rgba(255,255,255,.08); margin-bottom: 24px; }
.sidebar .brand-name {
  font-size: 14px; font-weight: 800; color: var(--sidebar-active);
  text-transform: uppercase; letter-spacing: .12em;
  font-family: 'JetBrains Mono', monospace;
}
.sidebar .brand-sub { font-size: 11px; color: var(--text-faint); margin-top: 4px; letter-spacing: .02em; }
.sidebar nav a {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 24px; font-size: 13px; font-weight: 500;
  color: var(--sidebar-text); transition: all .15s ease;
  border-left: 3px solid transparent;
}
.sidebar nav a:hover { background: var(--sidebar-hover); color: var(--sidebar-active); }
.sidebar nav a.active {
  background: var(--sidebar-hover); color: var(--sidebar-active);
  border-left-color: var(--accent);
}
.sidebar .nav-icon { font-size: 16px; width: 22px; text-align: center; opacity: .7; }
.sidebar nav a.active .nav-icon { opacity: 1; }
.sidebar .cat-score {
  margin-left: auto; font-size: 11px; font-weight: 700;
  padding: 2px 8px; border-radius: 10px; letter-spacing: .02em;
  font-family: 'JetBrains Mono', monospace;
}
.sidebar .score-pass { background: rgba(16,185,129,.15); color: var(--green); }
.sidebar .score-fail { background: rgba(239,68,68,.15); color: var(--red); }
.sidebar .divider { border: none; border-top: 1px solid rgba(255,255,255,.06); margin: 16px 24px; }

/* ── Dark mode toggle ── */
.theme-toggle {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 24px; margin-top: 24px;
  font-size: 12px; color: var(--text-faint); cursor: pointer;
  transition: color .15s;
}
.theme-toggle:hover { color: var(--sidebar-active); }
.theme-toggle .toggle-track {
  width: 36px; height: 20px; border-radius: 10px;
  background: rgba(255,255,255,.12); position: relative;
  transition: background .2s;
}
.theme-toggle .toggle-thumb {
  width: 16px; height: 16px; border-radius: 50%;
  background: var(--sidebar-active); position: absolute;
  top: 2px; left: 2px; transition: transform .2s ease;
}
[data-theme="dark"] .theme-toggle .toggle-track { background: var(--accent); }
[data-theme="dark"] .theme-toggle .toggle-thumb { transform: translateX(16px); }

/* ── Main ── */
.main { padding: 40px 48px 64px; max-width: 1040px; }

/* ── Page header ── */
.page-header {
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 60%, #1a1040 100%);
  color: #fff; padding: 36px 40px; border-radius: var(--radius);
  margin-bottom: 36px; display: flex; gap: 36px; align-items: center;
  box-shadow: var(--shadow-lg); position: relative; overflow: hidden;
}
.page-header::before {
  content: ''; position: absolute; top: -50%; right: -20%; width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(99,102,241,.12) 0%, transparent 70%);
  pointer-events: none;
}
.page-header-text { flex: 1; position: relative; z-index: 1; }
.page-header .eyebrow {
  font-size: 11px; color: #64748b; text-transform: uppercase;
  letter-spacing: .14em; margin-bottom: 10px; font-weight: 500;
}
.page-header h1 {
  font-size: 28px; font-weight: 800; letter-spacing: -.4px; color: #f8fafc;
  line-height: 1.2;
}
.page-header .meta { font-size: 12px; color: #64748b; margin-top: 8px; letter-spacing: .01em; }
.verdict-pill {
  display: inline-flex; align-items: center; gap: 10px;
  background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
  padding: 10px 20px; border-radius: var(--radius-sm); margin-top: 16px;
  backdrop-filter: blur(8px);
}
.verdict-pill .v-label { font-size: 20px; font-weight: 800; color: __OC__; letter-spacing: -.2px; }
.verdict-pill .v-sub { font-size: 13px; color: #94a3b8; }
.score-ring { display: flex; flex-direction: column; align-items: center; gap: 6px; position: relative; z-index: 1; }
.grade-badge {
  font-size: 48px; font-weight: 900; color: __GC__; line-height: 1;
  font-family: 'JetBrains Mono', monospace;
}
.grade-label { font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: .08em; }

/* ── Stat grid ── */
.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 36px; }
.stat-card {
  background: var(--surface); border-radius: var(--radius); padding: 24px;
  text-align: center; border: 1px solid var(--border-light);
  box-shadow: var(--shadow-sm); transition: transform .15s ease, box-shadow .15s ease;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.stat-card .n {
  font-size: 36px; font-weight: 900; line-height: 1;
  font-family: 'JetBrains Mono', monospace;
  font-variant-numeric: tabular-nums;
}
.stat-card .lbl {
  font-size: 11px; color: var(--text-muted); margin-top: 8px;
  text-transform: uppercase; letter-spacing: .08em; font-weight: 600;
}

/* ── Cards ── */
.card {
  background: var(--surface); border-radius: var(--radius); padding: 32px;
  box-shadow: var(--shadow-sm); margin-bottom: 28px;
  border: 1px solid var(--border-light);
  transition: box-shadow .2s ease;
}
.card:hover { box-shadow: var(--shadow-md); }
.card-title {
  font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 20px;
  display: flex; align-items: center; gap: 10px;
  letter-spacing: -.15px;
}
.cat-bars { display: flex; flex-direction: column; gap: 16px; }
.cat-bar-row { display: flex; align-items: center; gap: 14px; }
.cat-bar-label { font-size: 13px; color: var(--text-secondary); min-width: 130px; font-weight: 500; }

/* ── Tables ── */
table { width: 100%; border-collapse: collapse; }
th {
  padding: 10px 14px; text-align: left; font-size: 11px;
  text-transform: uppercase; color: var(--text-muted);
  font-weight: 600; letter-spacing: .06em;
  border-bottom: 2px solid var(--border);
}
td { padding: 12px 14px; border-bottom: 1px solid var(--border-light); font-size: 13px; }

/* ── Footer ── */
.footer {
  font-size: 12px; color: var(--text-muted); text-align: center;
  margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--border);
  letter-spacing: .01em;
}

/* ── Collapsibles ── */
.collapsible-header {
  cursor: pointer; user-select: none;
  display: flex; align-items: center; gap: 10px;
  transition: color .15s;
}
.collapsible-header:hover { color: var(--accent); }
.collapsible-header::before {
  content: '▸'; font-size: 13px; color: var(--text-muted);
  transition: transform .2s ease; display: inline-block;
}
.collapsible-header.open::before { transform: rotate(90deg); }
.collapsible-body { overflow: hidden; transition: max-height .25s ease; }
.collapsible-body.closed { max-height: 0; }
.heatmap-row { cursor: pointer; transition: background .12s; }
.heatmap-row:hover { background: var(--surface-alt); }
.filter-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(99,102,241,.1); color: var(--accent);
  padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;
  margin-bottom: 14px;
}
.filter-tag .x { cursor: pointer; font-size: 15px; line-height: 1; }

/* ── Animations ── */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.animate-in {
  animation: fadeInUp .4s cubic-bezier(.2,0,0,1) both;
}
.stat-card:nth-child(1) { animation-delay: .05s; }
.stat-card:nth-child(2) { animation-delay: .1s; }
.stat-card:nth-child(3) { animation-delay: .15s; }
.stat-card:nth-child(4) { animation-delay: .2s; }
.card { animation: fadeInUp .4s cubic-bezier(.2,0,0,1) both; }

/* ── Responsive ── */
@media(max-width:768px){
  .layout{grid-template-columns:1fr}
  .sidebar{position:static;height:auto;border-right:none;border-bottom:1px solid var(--border)}
  .main{padding:24px}
  .stat-grid{grid-template-columns:repeat(2,1fr)}
  .page-header{flex-direction:column;padding:28px}
  .page-header h1{font-size:22px}
}
@media print{
  .sidebar{display:none}
  .layout{grid-template-columns:1fr}
  .main{padding:20px}
  body{background:#fff;color:#000}
  .card{box-shadow:none;border:1px solid #ddd}
  .page-header{background:#1e293b!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .theme-toggle{display:none}
  .stat-card:hover,.card:hover{transform:none;box-shadow:none}
  @keyframes fadeInUp{from{opacity:1;transform:none}to{opacity:1;transform:none}}
}
</style>
</head>
<body>
<div class="layout">

<aside class="sidebar">
  <div class="brand">
    <div class="brand-name">Cogent</div>
    <div class="brand-sub">Audit Report</div>
  </div>
  <nav>
    <a href="#overview" class="active"><span class="nav-icon">&#128203;</span>Overview
      <span class="cat-score __OS__">__OL__</span>
    </a>
    <hr class="divider">
    <a href="#security"><span class="nav-icon">&#128274;</span>Security
      <span class="cat-score __SS__">__SEC_PASS__/__SEC_TOTAL__</span>
    </a>
    <a href="#quality"><span class="nav-icon">&#128202;</span>Quality
      <span class="cat-score __QS__">__QUAL_PASS__/__QUAL_TOTAL__</span>
    </a>
    <a href="#compliance"><span class="nav-icon">&#128203;</span>Compliance
      <span class="cat-score __CS__">__COMP_PASS__/__COMP_TOTAL__</span>
    </a>
    <hr class="divider">
    <a href="#remediation"><span class="nav-icon">&#128295;</span>Remediation</a>
  </nav>
  <div class="theme-toggle" onclick="toggleTheme()">
    <div class="toggle-track"><div class="toggle-thumb"></div></div>
    <span class="theme-label">Dark mode</span>
  </div>
</aside>

<main class="main">

<div id="overview">

<div class="page-header animate-in">
  <div class="page-header-text">
    <div class="eyebrow">Automated Code Audit Report</div>
    <h1>__PROJECT__</h1>
    <div class="meta">Generated __DATE__ &nbsp;&middot;&nbsp; Path: __PATH__ &nbsp;&middot;&nbsp; Cogent v__VERSION__</div>
    <div class="verdict-pill">
      <span class="v-label">__OVERALL_LABEL__</span>
      <span class="v-sub">__PCT__% of __TOTAL__ checks passed</span>
    </div>
  </div>
  <div class="score-ring">
    __DONUT__
    <div class="grade-badge" style="color:__GC__">__GRADE__</div>
    <div class="grade-label">Health Grade</div>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card animate-in"><div class="n" style="color:var(--text)">__TOTAL__</div><div class="lbl">Total Checks</div></div>
  <div class="stat-card animate-in"><div class="n" style="color:var(--green)">__PASSED_N__</div><div class="lbl">Passed</div></div>
  <div class="stat-card animate-in"><div class="n" style="color:var(--red)">__FAILED_N__</div><div class="lbl">Failed</div></div>
  <div class="stat-card animate-in"><div class="n" style="color:__GC__">__HEALTH__/100</div><div class="lbl">Health Score</div></div>
</div>

<div class="card">
  <div class="card-title">&#128200; Category Breakdown</div>
  <div class="cat-bars">
    <div class="cat-bar-row"><span class="cat-bar-label">&#128274; Security</span>__SEC_BAR__</div>
    <div class="cat-bar-row"><span class="cat-bar-label">&#128202; Quality</span>__QUAL_BAR__</div>
    <div class="cat-bar-row"><span class="cat-bar-label">&#128203; Compliance</span>__COMP_BAR__</div>
  </div>
</div>

__SEVERITY_CHART__

__SPARKLINE__

__FILE_HEATMAP__

<div class="card">
  <div class="card-title">&#127919; Executive Summary</div>
  <p style="font-size:14px;color:var(--text-secondary);line-height:1.7;margin-bottom:24px">__EXEC_VERDICT__</p>
  <div style="font-weight:700;font-size:13px;color:var(--text);margin-bottom:14px">Top Priority Actions</div>
  __TOP3_HTML__
</div>

</div>

<div class="card" id="remediation" style="scroll-margin-top:80px">
  <div class="card-title">&#128295; Remediation Checklist
    <span style="font-size:12px;font-weight:400;color:var(--text-muted);margin-left:6px">&#8212; ranked by severity</span>
  </div>
  <p style="font-size:13px;color:var(--text-muted);margin-bottom:18px">Address Critical and High items before any release.</p>
  __REMEDIATION_HTML__
</div>

__FINDINGS_SECTION__

__GAUGE__

__QUAL_SECTION__
__SEC_SECTION__
__COMP_SECTION__

<div class="footer">
  Generated by <strong>Cogent</strong> &#8212; automated code quality &amp; security auditing &nbsp;&middot;&nbsp; __DATE__<br>
  <span style="color:var(--text-faint)">This report is machine-generated. Results should be reviewed by a qualified engineer before use in compliance filings.</span>
</div>

</main>
</div>

<script>
// ── Theme toggle ──
function toggleTheme(){
  const html=document.documentElement;
  const isDark=html.getAttribute('data-theme')==='dark';
  html.setAttribute('data-theme',isDark?'':'dark');
  localStorage.setItem('cogent-theme',isDark?'':'dark');
  document.querySelector('.theme-label').textContent=isDark?'Dark mode':'Light mode';
}
// Restore saved theme
(function(){
  const saved=localStorage.getItem('cogent-theme');
  if(saved==='dark'){
    document.documentElement.setAttribute('data-theme','dark');
    document.addEventListener('DOMContentLoaded',function(){
      const l=document.querySelector('.theme-label');
      if(l) l.textContent='Light mode';
    });
  }
})();

// ── Sidebar active link ──
const sections = document.querySelectorAll('[id]');
const links = document.querySelectorAll('.sidebar nav a');
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if(e.isIntersecting){
      links.forEach(l=>l.classList.remove('active'));
      const a = document.querySelector('.sidebar nav a[href="#'+e.target.id+'"]');
      if(a) a.classList.add('active');
    }
  });
},{threshold:0.2});
sections.forEach(s=>obs.observe(s));

// ── Collapsible findings ──
function toggleCollapsible(h){
  const body = h.nextElementSibling;
  if(!body) return;
  body.classList.toggle('closed');
  h.classList.toggle('open');
  if(!body.classList.contains('closed')){
    body.style.maxHeight = body.scrollHeight + 'px';
  } else {
    body.style.maxHeight = '0px';
  }
}
document.querySelectorAll('.collapsible-header').forEach(h=>{
  h.addEventListener('click', ()=>toggleCollapsible(h));
});

// ── Findings search ──
function filterFindings(q){
  const rows = document.querySelectorAll('.finding-row');
  rows.forEach(r=>{
    const txt = r.textContent.toLowerCase();
    r.style.display = txt.includes(q.toLowerCase()) ? '' : 'none';
  });
}

// ── File heatmap click-to-filter ──
let activeFileFilter = '';
function filterByFile(file){
  activeFileFilter = file;
  const rows = document.querySelectorAll('.finding-row');
  rows.forEach(r=>{
    const cell = r.querySelector('td');
    if(cell){
      const f = cell.textContent.trim();
      r.style.display = f === file ? '' : 'none';
    }
  });
  let badge = document.getElementById('file-filter-badge');
  if(!badge){
    badge = document.createElement('div');
    badge.id = 'file-filter-badge';
    badge.className = 'filter-tag';
    const header = document.querySelector('#findings .card-title');
    if(header) header.parentNode.insertBefore(badge, header.nextSibling);
  }
  badge.innerHTML = 'File: ' + file + ' <span class="x" onclick="clearFileFilter()">&times;</span>';
  badge.style.display = 'inline-flex';
}
function clearFileFilter(){
  activeFileFilter = '';
  const rows = document.querySelectorAll('.finding-row');
  rows.forEach(r=>r.style.display = '');
  const badge = document.getElementById('file-filter-badge');
  if(badge) badge.style.display = 'none';
}
document.querySelectorAll('.heatmap-row').forEach(row=>{
  row.addEventListener('click', ()=>{
    const fileDiv = row.querySelector('div');
    if(fileDiv) filterByFile(fileDiv.textContent.trim());
  });
});
</script>
</body>
</html>
