        "format": {"type": "string", "default": "json"}
      },
      "outputs": {
        "type": "array",
        "items": {"properties": {"file": {"type": "string"}, "item": {"type": "string"}, "lcom": {"type": "number"}, "severity": {"type": "string"}}}
      }
    },
    {
      "name": "comments",
      "description": "Comment ratio analysis. Flags files below the minimum comment-to-code ratio.",
