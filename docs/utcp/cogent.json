      "average_response_size": 512,
      "call": {
        "syntax": "cogent secrets {path} --recursive --format {format}",
        "protocol": "cli",
        "cwd": "{project_root}"
      },
      "inputs": {
        "path": {"type": "string", "required": true},
        "recursive": {"type": "boolean", "default": true},
        "format": {"type": "string", "default": "json"}
      },
      "outputs": {
        "type": "array",
        "items": {"properties": {"file": {"type": "string"}, "line": {"type": "number"}, "rule_id": {"type": "string"}, "severity": {"type": "string"}, "message": {"type": "string"}}}
      },
      "error_handling": {"exit_codes": {"0": "No secrets found", "1": "Secrets detected"}}
    },
    {
      "name": "deadcode",
      "description": "Dead code and unreachable branch detection.",
      "tags": ["quality", "dead-code", "cleanup"],
      "average_response_size": 512,
      "call": {
        "syntax": "cogent deadcode {path} --recursive --format {format}",
        "protocol": "cli",
