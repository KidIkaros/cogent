      },
      "inputs": {
        "path": {"type": "string", "required": true},
        "recursive": {"type": "boolean", "default": true},
        "format": {"type": "string", "default": "json"}
      },
      "outputs": {
        "type": "array",
        "items": {"properties": {"file": {"type": "string"}, "line": {"type": "number"}, "item": {"type": "string"}, "severity": {"type": "string"}}}
      }
    },
    {
      "name": "cohesion",
      "description": "LCOM4 cohesion analysis. Low cohesion = struct/class doing too many things.",
