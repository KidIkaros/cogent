{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogent.dev/schemas/crypto-check-report.schema.json",
  "title": "CryptoCheckReport",
  "description": "Cryptography security scan report",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CryptoFinding"
      }
    },
    "summary": {
      "$ref": "#/$defs/CryptoSummary"
    }
  },
  "$defs": {
    "CryptoFinding": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "CryptoSummary": {
      "type": "object",
      "properties": {
        "files_scanned": {
          "type": "integer"
        },
        "total_findings": {
          "type": "integer"
        },
        "critical": {
          "type": "integer"
        },
        "high": {
          "type": "integer"
        },
        "medium": {
          "type": "integer"
        },
        "low": {
          "type": "integer"
        },
        "max_findings_threshold": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
