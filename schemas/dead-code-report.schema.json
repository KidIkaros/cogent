{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogent.dev/schemas/dead-code-report.schema.json",
  "title": "DeadCodeReport",
  "description": "Dead code detection report",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DeadCodeFinding"
      }
    },
    "summary": {
      "$ref": "#/$defs/DeadCodeSummary"
    }
  },
  "$defs": {
    "DeadCodeFinding": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "symbol": {
          "type": "string"
        },
        "symbol_type": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "DeadCodeSummary": {
      "type": "object",
      "properties": {
        "files_scanned": {
          "type": "integer"
        },
        "total_findings": {
          "type": "integer"
        },
        "unused_functions": {
          "type": "integer"
        },
        "unused_variables": {
          "type": "integer"
        },
        "unreachable_branches": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
