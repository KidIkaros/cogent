{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogent.dev/schemas/error-handling-report.schema.json",
  "title": "ErrorHandlingReport",
  "description": "Error handling pattern analysis report",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ErrFinding"
      }
    },
    "summary": {
      "$ref": "#/$defs/ErrSummary"
    }
  },
  "$defs": {
    "ErrFinding": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "pattern": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ErrSummary": {
      "type": "object",
      "properties": {
        "files_scanned": {
          "type": "integer"
        },
        "total_findings": {
          "type": "integer"
        },
        "unwrap_count": {
          "type": "integer"
        },
        "expect_count": {
          "type": "integer"
        },
        "discard_count": {
          "type": "integer"
        },
        "panic_count": {
          "type": "integer"
        },
        "max_unwraps_threshold": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
