{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogent.dev/schemas/risk-map-report.schema.json",
  "title": "RiskMapReport",
  "description": "Risk map churn-complexity analysis report",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RiskFile"
      }
    },
    "summary": {
      "$ref": "#/$defs/RiskSummary"
    }
  },
  "$defs": {
    "RiskFile": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "complexity": {
          "type": "integer"
        },
        "churn": {
          "type": "integer"
        },
        "risk_score": {
          "type": "number"
        },
        "unsafe_blocks": {
          "type": "integer"
        },
        "above_threshold": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "RiskSummary": {
      "type": "object",
      "properties": {
        "total_files": {
          "type": "integer"
        },
        "high_risk": {
          "type": "integer"
        },
        "medium_risk": {
          "type": "integer"
        },
        "low_risk": {
          "type": "integer"
        },
        "total_unsafe": {
          "type": "integer"
        },
        "max_risk_threshold": {
          "type": "number"
        },
        "danger_zone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
