{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogent.dev/schemas/secrets-report.schema.json",
  "title": "SecretsReport",
  "description": "Hardcoded secrets detection report",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SecretsFinding"
      }
    },
    "summary": {
      "$ref": "#/$defs/SecretsSummary"
    }
  },
  "$defs": {
    "SecretsFinding": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "secret_type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "SecretsSummary": {
      "type": "object",
      "properties": {
        "files_scanned": {
          "type": "integer"
        },
        "findings_count": {
          "type": "integer"
        },
        "high_severity": {
          "type": "integer"
        },
        "medium_severity": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
