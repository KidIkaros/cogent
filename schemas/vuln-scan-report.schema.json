{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogent.dev/schemas/vuln-scan-report.schema.json",
  "title": "VulnScanReport",
  "description": "Vulnerability scan report",
  "type": "object",
  "properties": {
    "vulnerabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Vulnerability"
      }
    },
    "summary": {
      "$ref": "#/$defs/VulnSummary"
    }
  },
  "$defs": {
    "Vulnerability": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "cve_id": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "cvss_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "fixed_in": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "VulnSummary": {
      "type": "object",
      "properties": {
        "packages_scanned": {
          "type": "integer"
        },
        "total_vulnerabilities": {
          "type": "integer"
        },
        "critical": {
          "type": "integer"
        },
        "high": {
          "type": "integer"
        },
        "medium": {
          "type": "integer"
        },
        "low": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
